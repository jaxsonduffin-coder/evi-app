rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ---- Helpers ----
    function isSignedIn() {
      return request.auth != null;
    }
    function isUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function householdMemberIds(householdId) {
      return get(/databases/$(database)/documents/households/$(householdId)).data.memberIds;
    }
    function isHouseholdMember(householdId) {
      return isSignedIn() && request.auth.uid in householdMemberIds(householdId);
    }

    // ---- Users ----
    match /users/{userId} {
      allow read: if isUser(userId);
      allow create: if isUser(userId);
      allow update: if isUser(userId);
      // No delete — user deletion happens through auth flow
    }

    // ---- Households ----
    match /households/{householdId} {
      allow read: if isHouseholdMember(householdId);
      allow create: if isSignedIn() &&
        request.auth.uid in request.resource.data.memberIds;
      allow update: if isHouseholdMember(householdId);
      allow delete: if isHouseholdMember(householdId) &&
        resource.data.createdBy == request.auth.uid;
    }

    // ---- Home Profiles ----
    match /homeProfiles/{profileId} {
      allow read, update, delete: if isSignedIn() &&
        isHouseholdMember(resource.data.householdId);
      allow create: if isSignedIn() &&
        isHouseholdMember(request.resource.data.householdId);
    }

    // ---- Documents ----
    match /documents/{documentId} {
      allow read: if isSignedIn() && isHouseholdMember(resource.data.householdId);
      allow create: if isSignedIn() &&
        isHouseholdMember(request.resource.data.householdId);
      allow update, delete: if isSignedIn() &&
        isHouseholdMember(resource.data.householdId);
    }

    // ---- Tasks ----
    match /tasks/{taskId} {
      allow read: if isSignedIn() && isHouseholdMember(resource.data.householdId);
      allow create: if isSignedIn() &&
        isHouseholdMember(request.resource.data.householdId);
      allow update, delete: if isSignedIn() &&
        isHouseholdMember(resource.data.householdId);
    }

    // ---- Alerts ----
    match /alerts/{alertId} {
      allow read, update: if isSignedIn() &&
        isHouseholdMember(resource.data.householdId);
      allow create: if isSignedIn() &&
        isHouseholdMember(request.resource.data.householdId);
      allow delete: if isSignedIn() &&
        isHouseholdMember(resource.data.householdId);
    }

    // ---- Calendar Events ----
    match /events/{eventId} {
      allow read: if isSignedIn() && isHouseholdMember(resource.data.householdId);
      allow create: if isSignedIn() &&
        isHouseholdMember(request.resource.data.householdId);
      allow update, delete: if isSignedIn() &&
        isHouseholdMember(resource.data.householdId);
    }

    // ---- Vehicles ----
    match /vehicles/{vehicleId} {
      allow read: if isSignedIn() && isHouseholdMember(resource.data.householdId);
      allow create: if isSignedIn() &&
        isHouseholdMember(request.resource.data.householdId);
      allow update, delete: if isSignedIn() &&
        isHouseholdMember(resource.data.householdId);
    }

    // ---- Important Dates (Birthdays, Anniversaries) ----
    match /importantDates/{dateId} {
      allow read, update, delete: if isSignedIn() &&
        isHouseholdMember(resource.data.householdId);
      allow create: if isSignedIn() &&
        isHouseholdMember(request.resource.data.householdId);
    }

    // ---- Chat History (Ask EVI) ----
    match /chats/{chatId} {
      allow read, update, delete: if isSignedIn() &&
        isHouseholdMember(resource.data.householdId);
      allow create: if isSignedIn() &&
        isHouseholdMember(request.resource.data.householdId);
    }
  }
}
